{
  "name": "purge-email",
  "scripts": {
    "auth": "tsx --env-file-if-exists=.env src/cli.ts auth",
    "plan": "tsx --env-file-if-exists=.env src/cli.ts plan",
    "apply": "tsx --env-file-if-exists=.env src/cli.ts apply",
    "spam": "tsx --env-file-if-exists=.env src/cli.ts spam",
    "typecheck": "tsc",
    "app": "npm --prefix app run tauri dev",
    "app:build": "npm --prefix app run tauri build",
    "app:test": "npm --prefix app test"
  },
  "type": "module",
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "googleapis": "^183.0.0",
    "p-limit": "^7.3.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "private": "true"
}
